# ============================================================
# Video Swap Pipeline — Environment Configuration
# Copy to .env and customize as needed
# ============================================================

# Redis / Celery
VSWAP_REDIS_URL=redis://localhost:6379/0
VSWAP_CELERY_BROKER_URL=redis://localhost:6379/0
VSWAP_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage directories
VSWAP_UPLOAD_DIR=/tmp/vswap/uploads
VSWAP_PROCESSED_DIR=/tmp/vswap/processed
VSWAP_OUTPUT_DIR=/tmp/vswap/output

# Video constraints
VSWAP_MAX_VIDEO_DURATION_SECONDS=600
VSWAP_CHUNK_MIN_SECONDS=5.0
VSWAP_CHUNK_MAX_SECONDS=10.0
VSWAP_MAX_PARALLEL_WORKERS=4

# Model IDs (HuggingFace)
VSWAP_DIFFUSION_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
VSWAP_CONTROLNET_OPENPOSE_MODEL=lllyasviel/control_v11p_sd15_openpose
VSWAP_CONTROLNET_DEPTH_MODEL=lllyasviel/control_v11f1p_sd15_depth
VSWAP_IP_ADAPTER_MODEL=h94/IP-Adapter-FaceID-Plus
VSWAP_ANIMATEDIFF_MODEL=guoyww/animatediff-motion-adapter-v1-5-3
VSWAP_WAV2LIP_CHECKPOINT=checkpoints/wav2lip_gan.pth

# Inference hyperparameters
VSWAP_LATENT_RESOLUTION=512
VSWAP_MAX_LATENT_RESOLUTION=1024
VSWAP_INFERENCE_STEPS=30
VSWAP_GUIDANCE_SCALE=7.5
VSWAP_CONTROLNET_CONDITIONING_SCALE=0.8
VSWAP_IP_ADAPTER_SCALE=0.6

# Face compositing
VSWAP_FACE_MASK_DILATION_PX=15
VSWAP_BILATERAL_FILTER_D=9
VSWAP_BILATERAL_SIGMA_COLOR=75.0
VSWAP_BILATERAL_SIGMA_SPACE=75.0

# Hardware
VSWAP_GPU_DEVICES=[0]
VSWAP_LOG_LEVEL=INFO
